// Prisma Schema for Chùa Online - Tu Tiên Nhàn Nhã
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users table - Stores Discord user identification
model User {
  id           String   @id @default(uuid())
  discordId    String   @unique @map("discord_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  character    Character?

  @@map("users")
}

// Characters table - Main player data
model Character {
  id                      String   @id @default(uuid())
  userId                  String   @map("user_id") @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dharmaName              String?  @map("dharma_name")
  realmId                 String   @map("realm_id")
  realmStage              Int      @map("realm_stage")
  cultivation             BigInt   @default(0) @map("cultivation")
  spiritStone             BigInt   @default(500) @map("spirit_stone")
  merit                   BigInt   @default(0) @map("merit")
  daoHeart                BigInt   @default(0) @map("dao_heart")
  spiritualRootId         String   @map("spiritual_root_id")
  rootChangedCount        Int      @default(0) @map("root_changed_count")
  totalBreakthroughs      Int      @default(0) @map("total_breakthroughs")
  currentTitleId          String?  @map("current_title_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  // Relations
  spiritualRoot           SpiritualRoot @relation(fields: [spiritualRootId], references: [id])
  cultivationSessions     CultivationSession[]
  activityLogs            ActivityLog[]
  userQuests              UserQuest[]
  inventory               Inventory[]
  rootChangeLogs          RootChangeLog[]
  checkins                DailyCheckin[]
  characterAchievements   CharacterAchievement[]
  transactions            Transaction[]

  @@map("characters")
}

// Spiritual Roots table - Configuration for root types
model SpiritualRoot {
  id         String  @id @map("id")
  name       String  @map("name")
  chance     Int     @map("chance")
  multiplier Decimal @map("multiplier") @db.Decimal(6, 2)
  enabled    Boolean @default(true) @map("enabled")

  characters Character[]

  @@map("spiritual_roots")
}

// Cultivation Sessions table - For cultivation and retreat
model CultivationSession {
  id              String   @id @default(uuid())
  characterId     String   @map("character_id")
  character       Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sessionType     String   @map("session_type") // 'normal' or 'retreat'
  startedAt       DateTime @map("started_at")
  endsAt          DateTime @map("ends_at")
  durationSeconds Int      @map("duration_seconds")
  baseReward      BigInt   @map("base_reward")
  status          String   @map("status") // 'running', 'claimed', 'cancelled'
  claimedAt       DateTime? @map("claimed_at")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("cultivation_sessions")
}

// Root Change Logs table - History of root changes
model RootChangeLog {
  id         String   @id @default(uuid())
  characterId String  @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  oldRootId  String   @map("old_root_id")
  newRootId  String   @map("new_root_id")
  itemId     String   @map("item_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("root_change_logs")
}

// Items table - Available items
model Item {
  id              String   @id @map("id")
  name            String   @map("name")
  description     String   @map("description")
  itemType        String   @map("item_type") // 'elixir', 'consumable', etc.
  priceSpiritStone BigInt? @map("price_spirit_stone")
  enabled         Boolean  @default(true) @map("enabled")

  inventories Inventory[]
  rootChangeLogs RootChangeLog[]

  @@map("items")
}

// Inventory table - Player items
model Inventory {
  id         String   @id @default(uuid())
  characterId String  @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId     String   @map("item_id")
  item       Item     @relation(fields: [itemId], references: [id])
  quantity   Int      @default(1)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([characterId, itemId], name: "characterId_itemId")
  @@map("inventories")
}

// Temple Activities table - Configuration for temple activities
model TempleActivity {
  id                    String   @id @map("id")
  name                  String   @map("name")
  description           String   @map("description")
  baseCultivationReward BigInt   @map("base_cultivation_reward")
  meritReward           BigInt   @map("merit_reward")
  daoHeartReward        BigInt   @map("dao_heart_reward")
  dailyLimit            Int      @map("daily_limit")
  cooldownSeconds       Int      @map("cooldown_seconds")
  imageUrl              String?  @map("image_url")
  enabled               Boolean  @default(true) @map("enabled")

  activityLogs ActivityLog[]

  @@map("temple_activities")
}

// Activity Logs table - Record of completed activities
model ActivityLog {
  id                     String   @id @default(uuid())
  characterId            String   @map("character_id")
  character              Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  activityId             String   @map("activity_id")
  activity               TempleActivity @relation(fields: [activityId], references: [id])
  baseCultivation        BigInt   @map("base_cultivation")
  actualCultivation      BigInt   @map("actual_cultivation")
  meritReward            BigInt   @map("merit_reward")
  daoHeartReward         BigInt   @map("dao_heart_reward")
  createdAt              DateTime @default(now()) @map("created_at")

  @@map("activity_logs")
}

// Quests table - Quest definitions
model Quest {
  id            String   @id @map("id")
  name          String   @map("name")
  description   String   @map("description")
  questType     String   @map("quest_type") // 'daily' or 'longterm'
  targetValue   Int      @map("target_value")
  rewardJson    Json     @map("reward_json")
  resetType     String   @map("reset_type") // 'daily', 'weekly', 'once'
  enabled       Boolean  @default(true) @map("enabled")

  userQuests UserQuest[]

  @@map("quests")
}

// User Quests table - Player quest progress
model UserQuest {
  id         String   @id @default(uuid())
  characterId String  @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  questId    String   @map("quest_id")
  quest      Quest    @relation(fields: [questId], references: [id])
  progress   Int      @default(0)
  status     String   @map("status") // 'active', 'completed', 'claimed'
  claimedAt  DateTime? @map("claimed_at")
  periodKey  String   @map("period_key") // For daily/weekly resets
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([characterId, questId, periodKey])
  @@map("user_quests")
}

// Daily Checkins table
model DailyCheckin {
  id         String   @id @default(uuid())
  characterId String  @map("character_id")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  checkinDate String   @map("checkin_date") // YYYY-MM-DD
  streak      Int      @default(0)
  claimedAt  DateTime @default(now()) @map("claimed_at")

  @@unique([characterId, checkinDate], name: "characterId_checkinDate")
  @@map("daily_checkins")
}

// Achievements table
model Achievement {
  id          String   @id @map("id")
  name        String   @map("name")
  description String   @map("description")
  conditionJson Json   @map("condition_json")
  rewardJson  Json     @map("reward_json")
  enabled     Boolean  @default(true) @map("enabled")

  characterAchievements CharacterAchievement[]

  @@map("achievements")
}

// Character Achievements table
model CharacterAchievement {
  id            String   @id @default(uuid())
  characterId   String   @map("character_id")
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  achievementId String   @map("achievement_id")
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  @@unique([characterId, achievementId])
  @@map("character_achievements")
}

// Transactions table - Ledger for all resource changes
model Transaction {
  id            String   @id @default(uuid())
  characterId   String   @map("character_id")
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  resourceType  String   @map("resource_type") // 'cultivation', 'spirit_stone', 'merit', 'dao_heart'
  amount        BigInt   @map("amount")
  reason        String   @map("reason")
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("transactions")
}

// Realm Definitions table
model RealmDefinition {
  id   String @id @map("id")
  name String @map("name")
  order Int    @map("order")

  @@map("realm_definitions")
}

// Realm Stages table - Cultivation requirements per stage
model RealmStage {
  id                   String @id @map("id")
  realmId              String @map("realm_id")
  stage                Int    @map("stage")
  requiredCultivation  BigInt @map("required_cultivation")
  requiredDaoHeart     BigInt? @map("required_dao_heart")
  requiredSpiritStone  BigInt? @map("required_spirit_stone")
  breakthroughRate     Decimal @map("breakthrough_rate") @db.Decimal(5, 2)

  @@unique([realmId, stage])
  @@map("realm_stages")
}
